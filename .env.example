# ==============================================================================
# Scorva — Platform Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# General & Environment
# ------------------------------------------------------------------------------
SCORVA_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# Frontend (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Scorva"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:8000"

# ------------------------------------------------------------------------------
# PostgreSQL Database
# ------------------------------------------------------------------------------
POSTGRES_USER=scorva
POSTGRES_PASSWORD=scorva_dev_password
POSTGRES_DB=scorva
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://scorva:scorva_dev_password@localhost:5432/scorva"

# ------------------------------------------------------------------------------
# Redis Cache & Task Broker
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"

# ------------------------------------------------------------------------------
# Artifact Storage (S3 / MinIO)
# ------------------------------------------------------------------------------
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="scorva-artifacts"
S3_REGION="us-east-1"

# ------------------------------------------------------------------------------
# AI Provider (Ollama)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL="http://localhost:11434"
DEFAULT_AI_MODEL="llama3:8b"

# ------------------------------------------------------------------------------
# Security & Secret Keys
# (Generate a secure 32+ byte string in production: openssl rand -hex 32)
# ------------------------------------------------------------------------------
SECRET_KEY="insecure-development-secret-key-change-in-production-min-32-chars"
ENCRYPTION_MASTER_KEY="insecure-encryption-key-for-dev-only-32bytes!"
SESSION_COOKIE_NAME="scorva_session"
SESSION_TTL_SECONDS=43200
